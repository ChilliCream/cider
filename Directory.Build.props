<Project>

  <PropertyGroup>
    <!-- Override on machines without the .NET 11 SDK: -p:CiderTargetFrameworks=net10.0 -->
    <CiderTargetFrameworks Condition="'$(CiderTargetFrameworks)' == ''">net10.0;net11.0</CiderTargetFrameworks>
    <TargetFrameworks>$(CiderTargetFrameworks)</TargetFrameworks>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Docker wire DTOs are mutable bags of public collections by design, and test method
         names use underscores; these analyzer rules would fire on every one of them. -->
    <NoWarn>$(NoWarn);CA1002;CA1707;CA2227;CA1819;CA1848;CA5394</NoWarn>
  </PropertyGroup>

  <!--
    The released binary is Native AOT. IsAotCompatible turns the trim/AOT/
    single-file analyzers on for the three source libraries, so an IL2xxx/IL3xxx regression shows
    up on an ordinary `dotnet build` rather than at `dotnet publish` time (or, worse, at runtime).
    It is a library-only switch, so Cider.Daemon enables the same analyzers directly in its own
    project file. Test projects stay out: they reference xunit and are never published AOT.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Cider.Core'
                            Or '$(MSBuildProjectName)' == 'Cider.AppleContainer'
                            Or '$(MSBuildProjectName)' == 'Cider.Dns'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
