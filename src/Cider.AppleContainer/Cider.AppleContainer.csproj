<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cider.AppleContainer</RootNamespace>
    <AssemblyName>Cider.AppleContainer</AssemblyName>
    <!-- Needed by src/Cider.AppleContainer/Xpc: the block-literal ABI (Xpc/XpcBlock.cs) and the
         xpc_dictionary_get_data/xpc_dictionary_get_string dictionary-owned-memory accessors are
         pointer types by nature (docs/spikes/xpc-probe/XpcProbe/Xpc.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cider.Core\Cider.Core.csproj" />
  </ItemGroup>

</Project>
