<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately NOT part of Cider.sln: this is a fixture the E2E suite shells out to with
       `dotnet run`, so that a real .NET Aspire AppHost (and the DCP orchestrator it ships) drives
       the daemon from a separate process with its own DOCKER_HOST. Adding it to the solution would
       drag the Aspire SDK, the DCP binaries and the dashboard into every ordinary build. -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.0" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Single-targeted on purpose: the repository Directory.Build.props sets TargetFrameworks
         (plural), which makes MSBuild take the cross-targeting path, and that path never imports
         Microsoft.NET.RuntimeIdentifierInference.targets - so Aspire.AppHost.Sdk's call to the
         PickBestRid task fails with MSB4036. -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>E2EAspireAppHost</RootNamespace>
    <AssemblyName>e2e-aspire-apphost</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHost>true</IsAspireHost>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!-- The fixture deliberately runs without the Aspire CLI bundle (plain `dotnet run`). -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>cider-aspire-e2e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.0" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.5.0" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\E2EAspireConsumer\E2EAspireConsumer.csproj" />
  </ItemGroup>

</Project>
